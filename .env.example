# Environment variable template for the Smart E-Commerce Growth AI Agent.
# Placeholder names only - no real values or credentials belong in this file.
# Copy to .env (git-ignored) and fill in real values locally.

# --- Shopify store connection (integrations/adapters) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# Optional override - leave blank to use integrations/adapters/shopifyClient.js's default.
SHOPIFY_API_VERSION=

# --- Claude API connection (agent/core/claudeClient.js) ---
# Get a key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides - leave blank to use agent/core/claudeClient.js's defaults.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=

# --- Controlled retries (agent/core/networkRetry.js) ---
# Optional overrides - leave blank to use its defaults (3 attempts, 200ms base backoff).
MAX_NETWORK_RETRY_ATTEMPTS=
NETWORK_RETRY_BASE_DELAY_MS=

# --- Execution bounds (agent/core/executionBounds.js) ---
# Optional overrides - leave blank to use its defaults (100 entries, 20 plan steps).
MAX_ARRAY_FIELD_ENTRIES=
MAX_PLAN_STEPS_PER_RUN=

# --- Agent configuration ---
AGENT_ENV=
