# Environment variable template for the Smart E-Commerce Growth AI Agent.
# Placeholder names only - no real values or credentials belong in this file.
# Copy to .env (git-ignored) and fill in real values locally.

# --- HTTP server access control (security/serverAccessControl.js) ---
# REQUIRED to serve anything. The shared secret every request to /ask, /run,
# /orchestrate, /orchestrate/approve, and /history must present as an
# "Authorization: Bearer <key>" header. These endpoints reach real store data and
# spend real Claude/Shopify budget, so the server FAILS CLOSED: while this is unset or
# empty, all of them return 503 and none of them run. Generate a long random value
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# and keep it out of git, exactly like every other credential in this file.
# The dashboard asks whoever opens it for this value and keeps it for that browser
# session only - it is never baked into the served page.
AGENT_API_KEY=
# Optional overrides - leave blank to use security/serverAccessControl.js's defaults
# (a 60000ms window allowing 30 requests per API key, or per IP address for callers
# presenting no key). Counters are per-process and in-memory: they reset on restart.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# --- Shopify store connection (integrations/adapters) ---
SHOPIFY_STORE_DOMAIN=
# Use ONE of the two auth models below, matching how your Shopify app was created.
# Precedence: if SHOPIFY_CLIENT_ID and SHOPIFY_CLIENT_SECRET are both set, they are
# used and SHOPIFY_ADMIN_API_ACCESS_TOKEN is ignored; otherwise the access token is
# used exactly as before. See integrations/adapters/shopifyClient.js for details.
#
# Option A - classic custom app (static, copyable token from Shopify admin):
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
#
# Option B - app created via Shopify's Dev Dashboard (OAuth Client Credentials grant;
# get these from your app's Dev Dashboard "API access" / "Client credentials" page):
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional override - leave blank to use integrations/adapters/shopifyClient.js's default.
SHOPIFY_API_VERSION=

# --- Etsy publishing (integrations/adapters/etsyClient.js) ---
# NOT AVAILABLE YET. Etsy publishing needs BOTH of the following, and the project has
# neither - see integrations/adapters/etsyClient.js's header:
#   (a) the three credentials below, and
#   (b) a verified Etsy request mapping, including seller-specific ids (such as a
#       taxonomy id and a shipping profile id) that only exist inside a real seller
#       account. That mapping is deliberately NOT guessed anywhere in this project.
# Until both exist, etsyClient.publishListing() throws a clear error naming the gap and
# makes no network call. Filling these three in alone does NOT enable publishing.
#
# The registered Etsy application's keystring, from an Etsy developer app:
ETSY_API_KEYSTRING=
# An OAuth 2.0 access token for the seller, carrying the listing write scope:
ETSY_OAUTH_ACCESS_TOKEN=
# The seller's own numeric Etsy shop id, which every listing call is scoped to:
ETSY_SHOP_ID=

# --- Claude API connection (agent/core/claudeClient.js) ---
# Get a key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides - leave blank to use agent/core/claudeClient.js's defaults.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=

# --- Gemini API connection (agent/core/geminiClient.js) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides - leave blank to use agent/core/geminiClient.js's defaults.
GEMINI_MODEL=
GEMINI_MAX_TOKENS=

# --- Controlled retries (agent/core/networkRetry.js) ---
# Optional overrides - leave blank to use its defaults (3 attempts, 200ms base backoff,
# 30-second per-request timeout).
MAX_NETWORK_RETRY_ATTEMPTS=
NETWORK_RETRY_BASE_DELAY_MS=
# How long ONE Claude/Shopify request may run before it's treated as failed and (if
# retryable) retried - default 30000 (30s). A single Claude call that uses the
# web_search tool (tools/webCompetitorResearchTool.js) can run a real multi-round
# search-and-read loop server-side (Anthropic's own docs note comparative/multi-entity
# research can take 10+ searches) - 30s is not always enough for that, and the request
# is billed for its real input/output tokens whether it finishes or times out. Because
# a timeout is retried up to MAX_NETWORK_RETRY_ATTEMPTS times at this SAME timeout, a
# request that genuinely needs more time than the ceiling will keep failing (and
# re-spending tokens) on every retry, not just the first - raising this value (e.g.
# 120000 for 2 minutes) fixes that by letting the first attempt actually finish, rather
# than retrying more often. If you see "Could not reach the Claude API: Request timed
# out after ...ms" on a research/analysis step, raise this first before assuming
# anything else is wrong.
NETWORK_REQUEST_TIMEOUT_MS=

# --- Execution bounds (agent/core/executionBounds.js) ---
# Optional overrides - leave blank to use its defaults (100 entries, 20 plan steps).
MAX_ARRAY_FIELD_ENTRIES=
MAX_PLAN_STEPS_PER_RUN=

# --- Token controls (agent/core/tokenControls.js) ---
# Optional overrides - leave blank to use its defaults: a conservative 1024-output-
# token ceiling per single Claude call (MAX_TOKENS_PER_CALL), and 4x that
# (MAX_TOKENS_PER_RUN) as the total output-token budget across one Chief run. This is a
# deliberately conservative safety ceiling, not a fixed requirement - a tool that asks
# Claude to produce a larger structured result (e.g. tools/webCompetitorResearchTool.js
# reporting several competitors, each with multiple evidence fields) can still be
# silently capped down to this ceiling and have its reply cut off mid-answer if it's
# left too low. Raise MAX_TOKENS_PER_CALL (e.g. 8192) if you see a research/analysis
# step fail with "did not return structured ... in the expected shape" - that failure
# can mean Claude's real, in-progress answer was cut off before it could finish, not
# that anything is broken.
MAX_TOKENS_PER_CALL=
MAX_TOKENS_PER_RUN=

# --- Run history (agent/core/runHistoryStore.js) ---
# Optional override - leave blank to use its default: memory/state/runs/ (one JSON
# file per saved dashboard run - see memory/state/README.md). This is what makes a
# "Run a Specialist"/"Chief Orchestrator" result on the dashboard's History page
# survive a page refresh or a server restart. Only ever set this to point somewhere
# else (e.g. a different disk/mount) if you specifically need that - the default is
# correct for a normal local deployment.
RUN_HISTORY_STORE_DIR=

# --- Memory layer (agent/core/memoryStore.js) ---
# Optional override - leave blank to use its default: memory/state/business/ (one JSON
# file per verified/approved memory record, under a per-businessId records/ folder -
# see agent/core/memoryRecordModel.js). Business-isolated: each businessId only ever
# reads/writes its own subfolder. Only ever set this to point somewhere else (e.g. a
# different disk/mount) if you specifically need that - the default is correct for a
# normal local deployment.
#
# Wired into the Chief Orchestrator (agent/core/orchestratorExecutionContract.js via
# agent/core/memoryContextRetrieval.js): a run with a real businessId retrieves this
# business's own saved memory as context before dispatching, and saves a compact
# record of each specialist step that completes with verification_status 'passed'.
# Requires a real businessId to do anything - a run with no businessId (today's
# default single-business server.js behavior) never touches this at all.
MEMORY_STORE_DIR=

# --- Usage limits (agent/core/usageLimits.js) ---
# Optional overrides - leave blank to use its defaults (50/10/15/15 per run).
MAX_TOOL_CALLS_PER_RUN=
MAX_MODEL_CALLS_PER_RUN=
MAX_RESEARCH_CALLS_PER_RUN=
MAX_EXTERNAL_API_CALLS_PER_RUN=

# --- Agent configuration ---
# Selects which connection layer agent/core/aiProviderSelector.js delegates to.
# Accepted values: "claude" or "gemini". Leave blank to use the default ("gemini").
AI_PROVIDER=
AGENT_ENV=
