# Environment variable template for the Smart E-Commerce Growth AI Agent.
# Placeholder names only - no real values or credentials belong in this file.
# Copy to .env (git-ignored) and fill in real values locally.

# --- HTTP server access control (security/serverAccessControl.js) ---
# REQUIRED to serve anything. The shared secret every request to /ask, /run,
# /orchestrate, /orchestrate/approve, and /history must present as an
# "Authorization: Bearer <key>" header. These endpoints reach real store data and
# spend real Claude/Shopify budget, so the server FAILS CLOSED: while this is unset or
# empty, all of them return 503 and none of them run. Generate a long random value
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# and keep it out of git, exactly like every other credential in this file.
# The dashboard asks whoever opens it for this value and keeps it for that browser
# session only - it is never baked into the served page.
AGENT_API_KEY=
# Optional overrides - leave blank to use security/serverAccessControl.js's defaults
# (a 60000ms window allowing 30 requests per API key, or per IP address for callers
# presenting no key). Counters are per-process and in-memory: they reset on restart.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# --- Shopify store connection (integrations/adapters) ---
SHOPIFY_STORE_DOMAIN=
# Use ONE of the two auth models below, matching how your Shopify app was created.
# Precedence: if SHOPIFY_CLIENT_ID and SHOPIFY_CLIENT_SECRET are both set, they are
# used and SHOPIFY_ADMIN_API_ACCESS_TOKEN is ignored; otherwise the access token is
# used exactly as before. See integrations/adapters/shopifyClient.js for details.
#
# Option A - classic custom app (static, copyable token from Shopify admin):
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
#
# Option B - app created via Shopify's Dev Dashboard (OAuth Client Credentials grant;
# get these from your app's Dev Dashboard "API access" / "Client credentials" page):
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional override - leave blank to use integrations/adapters/shopifyClient.js's default.
SHOPIFY_API_VERSION=

# --- Shopify blog article publishing (integrations/shopifyBlogPublishing.js) ---
# REQUIRES THE write_content ADMIN API SCOPE. The read scopes above are not enough:
# integrations/adapters/shopifyClient.js checks the app's genuinely granted scopes before
# any mutation and refuses - making ZERO mutation attempts - when write_content is absent.
# Add write_content to your app's access scopes and re-deploy/re-install it to enable
# publishing; filling the two values below alone does NOT enable it.
#
# The approved blog to publish articles to, as an Admin API GID, e.g.
# gid://shopify/Blog/123456789. Never hardcoded in code - a missing value refuses rather
# than guessing a blog.
SHOPIFY_BLOG_ID=
# The byline published articles carry. Shopify's ArticleCreateInput requires an author, so
# a missing value refuses rather than inventing one.
SHOPIFY_ARTICLE_AUTHOR=

# --- Shopify product/inventory/collection write mutations (integrations/shopifyVendorCorrection.js,
# integrations/shopifyInventoryCorrection.js, integrations/shopifyCollectionMembership.js) ---
# REQUIRES write_products (productUpdate vendor correction, collectionAddProducts membership)
# AND write_inventory (inventoryAdjustQuantities) ADMIN API SCOPES, in addition to the read
# scopes above. integrations/adapters/shopifyClient.js checks the app's genuinely granted
# scopes before each of these mutations and refuses - making ZERO mutation attempts - when the
# relevant scope is absent. Add both to your app's access scopes and re-deploy/re-install it to
# enable these corrections; no new credential value is needed - they use the same
# SHOPIFY_STORE_DOMAIN/token configured above.

# --- Etsy publishing (integrations/adapters/etsyClient.js) ---
# NOT AVAILABLE YET. Etsy publishing needs BOTH of the following, and the project has
# neither - see integrations/adapters/etsyClient.js's header:
#   (a) the three credentials below, and
#   (b) a verified Etsy request mapping, including seller-specific ids (such as a
#       taxonomy id and a shipping profile id) that only exist inside a real seller
#       account. That mapping is deliberately NOT guessed anywhere in this project.
# Until both exist, etsyClient.publishListing() throws a clear error naming the gap and
# makes no network call. Filling these three in alone does NOT enable publishing.
#
# The registered Etsy application's keystring, from an Etsy developer app:
ETSY_API_KEYSTRING=
# An OAuth 2.0 access token for the seller, carrying the listing write scope:
ETSY_OAUTH_ACCESS_TOKEN=
# The seller's own numeric Etsy shop id, which every listing call is scoped to.
# OPTIONAL FOR READING, still required for the (closed) publishing path: the read client
# derives it from Etsy's own getMe endpoint under the shops_r scope it already holds when
# this is blank, and never guesses it. Set it to pin reads to one shop; leaving it blank
# means reads follow whichever shop the authorized account owns. Not a secret - it appears
# in your public shop URL.
ETSY_SHOP_ID=
#
# --- Etsy READ-ONLY access (integrations/adapters/etsyReadClient.js) ---
# Reading this shop's own data is a separate, working capability from publishing above.
# It uses OAuth 2.0 authorization code + PKCE and requests only two READ scopes -
# shops_r and listings_r. integrations/etsyOAuth.js refuses every other scope, so no
# write-capable token can be obtained by configuration.
#
# The application's SHARED SECRET, from the same Etsy developer app page as the keystring.
# Required for every v3 request: Etsy's x-api-key header must carry `keystring:shared_secret`,
# and sending the keystring alone is refused with
# "403: Shared secret is required in x-api-key header."
# This is a secret - it is never logged, and is redacted in audit records.
ETSY_SHARED_SECRET=
# The EXACT redirect URI registered on your Etsy application. There is deliberately no
# default: Etsy matches this string exactly against the registration, so a guessed value
# fails with a confusing error. Copy it verbatim from the Etsy developer portal.
ETSY_OAUTH_REDIRECT_URI=
# Obtained by running `npm run integrations:etsy-authorize` - do not paste one by hand.
# Etsy refresh tokens last 90 days; access tokens are held in memory only and never
# written to disk.
ETSY_OAUTH_REFRESH_TOKEN=
#
# Optional Etsy rate-limit and cache settings. Etsy's QPS/QPD numbers are specific to
# YOUR registered application and are visible only in the Etsy developer portal, so they
# are NOT defaulted here - leave them blank and no client-side spacing is applied (the
# bounded 429/Retry-After backoff still protects the API either way).
ETSY_QPS_LIMIT=
ETSY_QPD_LIMIT=
# How long an Etsy read may be reused from memory, in ms. Defaults to 60000 (1 minute).
# This is a request-reduction cache, not a data store - nothing is written to disk.
ETSY_CACHE_TTL_MS=

# --- Claude API connection (agent/core/claudeClient.js) ---
# Get a key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides - leave blank to use agent/core/claudeClient.js's defaults.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=

# --- Gemini API connection (agent/core/geminiClient.js) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides - leave blank to use agent/core/geminiClient.js's defaults.
GEMINI_MODEL=
GEMINI_MAX_TOKENS=

# --- Controlled retries (agent/core/networkRetry.js) ---
# Optional overrides - leave blank to use its defaults (3 attempts, 200ms base backoff,
# 30-second per-request timeout).
MAX_NETWORK_RETRY_ATTEMPTS=
NETWORK_RETRY_BASE_DELAY_MS=
# How long ONE Claude/Shopify request may run before it's treated as failed and (if
# retryable) retried - default 30000 (30s). A single Claude call that uses the
# web_search tool (tools/webCompetitorResearchTool.js) can run a real multi-round
# search-and-read loop server-side (Anthropic's own docs note comparative/multi-entity
# research can take 10+ searches) - 30s is not always enough for that, and the request
# is billed for its real input/output tokens whether it finishes or times out. Because
# a timeout is retried up to MAX_NETWORK_RETRY_ATTEMPTS times at this SAME timeout, a
# request that genuinely needs more time than the ceiling will keep failing (and
# re-spending tokens) on every retry, not just the first - raising this value (e.g.
# 120000 for 2 minutes) fixes that by letting the first attempt actually finish, rather
# than retrying more often. If you see "Could not reach the Claude API: Request timed
# out after ...ms" on a research/analysis step, raise this first before assuming
# anything else is wrong.
NETWORK_REQUEST_TIMEOUT_MS=

# --- Execution bounds (agent/core/executionBounds.js) ---
# Optional overrides - leave blank to use its defaults (100 entries, 20 plan steps).
MAX_ARRAY_FIELD_ENTRIES=
MAX_PLAN_STEPS_PER_RUN=

# --- Token controls (agent/core/tokenControls.js) ---
# Optional overrides - leave blank to use its defaults: a conservative 1024-output-
# token ceiling per single Claude call (MAX_TOKENS_PER_CALL), and 4x that
# (MAX_TOKENS_PER_RUN) as the total output-token budget across one Chief run. This is a
# deliberately conservative safety ceiling, not a fixed requirement - a tool that asks
# Claude to produce a larger structured result (e.g. tools/webCompetitorResearchTool.js
# reporting several competitors, each with multiple evidence fields) can still be
# silently capped down to this ceiling and have its reply cut off mid-answer if it's
# left too low. Raise MAX_TOKENS_PER_CALL (e.g. 8192) if you see a research/analysis
# step fail with "did not return structured ... in the expected shape" - that failure
# can mean Claude's real, in-progress answer was cut off before it could finish, not
# that anything is broken.
MAX_TOKENS_PER_CALL=
MAX_TOKENS_PER_RUN=

# --- Run history (agent/core/runHistoryStore.js) ---
# Optional override - leave blank to use its default: memory/state/runs/ (one JSON
# file per saved dashboard run - see memory/state/README.md). This is what makes a
# "Run a Specialist"/"Chief Orchestrator" result on the dashboard's History page
# survive a page refresh or a server restart. Only ever set this to point somewhere
# else (e.g. a different disk/mount) if you specifically need that - the default is
# correct for a normal local deployment.
RUN_HISTORY_STORE_DIR=

# --- Memory layer (agent/core/memoryStore.js) ---
# Optional override - leave blank to use its default: memory/state/business/ (one JSON
# file per verified/approved memory record, under a per-businessId records/ folder -
# see agent/core/memoryRecordModel.js). Business-isolated: each businessId only ever
# reads/writes its own subfolder. Only ever set this to point somewhere else (e.g. a
# different disk/mount) if you specifically need that - the default is correct for a
# normal local deployment.
#
# Wired into the Chief Orchestrator (agent/core/orchestratorExecutionContract.js via
# agent/core/memoryContextRetrieval.js): a run with a real businessId retrieves this
# business's own saved memory as context before dispatching, and saves a compact
# record of each specialist step that completes with verification_status 'passed'.
# Requires a real businessId to do anything - a run with no businessId (today's
# default single-business server.js behavior) never touches this at all.
MEMORY_STORE_DIR=

# --- Multi-business authorization (security/serverAccessControl.js) ---
# Which business_id values this AGENT_API_KEY is allowed to act for. A comma-separated
# list. The API key authenticates the CALLER; this says which businesses that caller may
# touch - a client-supplied business_id is never trusted as authorization on its own.
#
# Leave blank for a single-business deployment: only the default business (no business_id)
# is then allowed, which is exactly today's behaviour. Set it as soon as a second business
# exists, or one key can reach every business's data.
#
# A request naming a business outside this list is refused with an error that reveals
# nothing about which businesses exist, and /history never lists another business's runs.
AGENT_API_KEY_BUSINESS_IDS=

# --- Human approval provenance (approvals/approvalArchitecture.js) ---
# REQUIRED FOR ANY APPROVAL TO BE ACCEPTED. Until this is set, every approval fails closed
# and no consequential action can be approved by anyone - which presents as an approve
# button that always refuses. That is intended: a decision is only accountable if it is
# cryptographically proved, and a missing key means nothing can be proved.
#
# The Ed25519 PUBLIC key, in PEM form, of whoever is authorized to approve actions.
# Multi-line PEM: keep it on one line with literal 
 between the lines, or point your
# process manager at a file - it is read as a PEM string.
#
# THE PRIVATE KEY NEVER GOES HERE, NEVER GOES ANYWHERE IN THIS PROJECT, AND IS NEVER
# GENERATED BY IT. The approver holds it outside this system, signs the exact payload the
# server shows them, and pastes back only the signature. Nothing in approvals/ can sign, and
# a PRIVATE key pasted into this variable is refused with an explicit error rather than used.
# No example key - real or dummy - is printed in this file on purpose.
APPROVAL_PUBLIC_KEY=
# Optional override - how long a signed approval challenge stays valid, in milliseconds.
# Leave blank for the default (10 minutes). A challenge is single-use regardless: one
# signature authorizes exactly one decision.
APPROVAL_CHALLENGE_TTL_MS=

# --- Reliability controls (reliability/circuitBreaker.js) ---
# Optional overrides - leave blank for the defaults (3 consecutive failures to open a
# circuit, 30 minutes of cooldown before one recovery trial is permitted). COUNTS AND
# MINUTES, never money: this project has no model or platform price table, so a financial
# threshold here would have to be invented.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=
CIRCUIT_BREAKER_COOLDOWN_MINUTES=

# --- Persisted state locations ---
# Optional overrides - all default to the documented folders under memory/state/ and are
# correct for a normal deployment. Set one only if you genuinely need that data elsewhere
# (a different disk or mount). Every one of these holds real per-business data and is
# git-ignored.
#   monitoring/snapshotStore.js            - memory/state/snapshots/
SNAPSHOT_STORE_DIR=
#   scheduler/scheduleStore.js             - memory/state/schedules/
SCHEDULE_STORE_DIR=
#   reliability/circuitBreaker.js          - memory/state/circuits/
CIRCUIT_BREAKER_STORE_DIR=
#   reliability/executionVerification.js   - memory/state/verifications/
VERIFICATION_STORE_DIR=
#   approvals/approvalStore.js             - memory/state/approvals/
APPROVAL_STORE_DIR=

# --- Command Center sessions (agent/core/commandCenterSessionStore.js) ---
# Optional override - leave blank for its default, memory/state/sessions/ (one JSON file
# per Command Center conversation). Real business content; git-ignored.
COMMAND_CENTER_SESSION_DIR=

# --- Optimization cycle bound (agent/core/optimizationCycleOrchestrator.js) ---
# Optional override - the maximum number of iterations one optimization cycle may run.
# Leave blank for its conservative default. A bound on work, not a business target.
MAX_OPTIMIZATION_CYCLE_ITERATIONS=

# --- Network retry (agent/core/networkRetry.js) ---
# Optional override - the longest a Retry-After header from an external API will be
# honoured, in milliseconds. Leave blank for its default. Caps how long one call may wait
# when a third party asks for a long backoff; it never shortens this project's own retries.
MAX_RETRY_AFTER_DELAY_MS=

# --- Autonomy kill switch (agent/core/autonomyPolicy.js) ---
# THE ONE GLOBAL STOP. When this is off, the agent may not start ANY action on its own -
# not a consequential one, and not a low-risk read either, because a read still spends real
# Claude/Shopify/Etsy budget and still burns Etsy's per-application daily quota. A half-stop
# is not a stop.
#
# WHAT IT DOES NOT TOUCH. This governs AGENT-INITIATED work only. A person clicking Run on
# the dashboard, and an action a person has already approved with a real Ed25519 signature,
# are not autonomous and are unaffected - turning this off can never break the existing
# human-driven paths.
#
# IT CAN ONLY EVER SUBTRACT PERMISSION. Turning it on grants nothing by itself: a business
# must also enable autonomy in its own business.yaml (see configuration/business.example.yaml's
# `autonomy` block), and every other gate still applies - compliance, tool and platform
# authorization, the per-run and daily budgets, and the human-approval requirement. Turning it
# off withdraws autonomy from every business at once, immediately, without editing any config.
#
# FAILS CLOSED, TWICE OVER. Left blank or unset, autonomy is OFF - an unstated permission was
# never granted. Set to anything that is not clearly a yes or a no (a typo like "ture", or
# "maybe"), autonomy is also OFF and the policy reports the value as malformed so the operator
# is told rather than left believing the agent is running.
#
# Accepted values, case- and whitespace-insensitive: true / false, 1 / 0, on / off.
# Anything else is malformed, which blocks.
AGENT_AUTONOMY_ENABLED=

# --- Usage limits (agent/core/usageLimits.js) ---
# Optional overrides - leave blank to use its defaults (50/10/15/15 per run).
MAX_TOOL_CALLS_PER_RUN=
MAX_MODEL_CALLS_PER_RUN=
MAX_RESEARCH_CALLS_PER_RUN=
MAX_EXTERNAL_API_CALLS_PER_RUN=

# --- Web search provider (agent/core/webSearchProvider.js) ---
# WHICH provider retrieves web evidence. Deliberately SEPARATE from AI_PROVIDER below:
# a quota problem in one must never force a change of the other.
#   tavily            - Tavily retrieves, the AI provider reasons over the results.
#                       Needs TAVILY_API_KEY.
#   claude_web_search - Claude searches during its own turn (its hosted web_search tool).
#   gemini_grounding  - Gemini searches via Google Search grounding. Note this needs a
#                       grounding entitlement on the Google project; a free tier without
#                       one returns HTTP 429 for grounded requests while ordinary
#                       generation keeps working.
# Leave blank to use the default ("claude_web_search"), i.e. existing behaviour.
SEARCH_PROVIDER=

# Tavily API key, from https://app.tavily.com. Server-side only - it is sent in the
# Authorization header and never written into a result, a log, a session or the browser.
# When SEARCH_PROVIDER=tavily and this is blank, research stops with
# SEARCH_PROVIDER_NOT_CONFIGURED before any call is attempted, rather than failing oddly.
TAVILY_API_KEY=

# --- Agent configuration ---
# Selects which connection layer agent/core/aiProviderSelector.js delegates to. This is
# the REASONING provider only; web search is chosen separately, above.
# Accepted values: "claude" or "gemini". Leave blank to use the default ("gemini").
AI_PROVIDER=
AGENT_ENV=
